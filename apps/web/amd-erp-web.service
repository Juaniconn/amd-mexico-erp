[Unit]
Description=AMD ERP Next.js Web Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/data/projets/amd_web_app/apps/web
ExecStart=node node_modules/next/dist/bin/next start -p 3000
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PATH=/home/ubuntu/.local/bin/bin:/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
