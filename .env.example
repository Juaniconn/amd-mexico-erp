# ============================================
# AMD México — Variables de entorno
# Copiar a .env y ajustar valores
# ============================================

# ─── Base de datos (PostgreSQL) ───────────────────────────
DATABASE_URL="postgresql://erp:erp_password@localhost:5432/erp_db?schema=public"
POSTGRES_USER="erp"
POSTGRES_PASSWORD="erp_password"
POSTGRES_DB="erp_db"

# ─── Redis ────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=""

# ─── MinIO (almacenamiento S3-compatible) ─────────────────
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ROOT_USER="minioadmin"
MINIO_ROOT_PASSWORD="minioadmin123"
MINIO_BUCKET="erp-files"

# ─── Backend API (NestJS) ─────────────────────────────────
API_PORT=3001
API_HOST="0.0.0.0"
JWT_SECRET="cambiar-por-un-secret-secto-de-64-caracteres"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="cambiar-por-otro-secret-secto-de-64-caracteres"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Frontend (Next.js) ────────────────────────────────────
# Empty = same-origin (nginx proxies /api → Nest). Paths in code already use /api/...
# NEVER set to "/api" — that produces /api/api/... 404s.
# Optional absolute origin without /api: "http://localhost:3001"
NEXT_PUBLIC_API_URL=""
APP_URL="http://localhost:3000"

# ─── Agente cotización (opcional LLM) ─────────────────────
# Si está definido, estimar-precios refina con OpenAI tras heurística+PDF+mercado.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ─── App general ──────────────────────────────────────────
NODE_ENV="development"
TZ="America/Mexico_City"
DEFAULT_CURRENCY="MXN"
SUPPORTED_CURRENCIES="MXN,USD"

# ─── Multi-sucursal ───────────────────────────────────────
# Sucursal por defecto al crear registros
DEFAULT_SUCURSAL_ID="1"

# ─── Email (opcional, configuración futura) ────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@amd-mexico.com"

# ─── Backup ───────────────────────────────────────────────
BACKUP_DIR="/data/backups"
BACKUP_RETENTION_DAYS=7
