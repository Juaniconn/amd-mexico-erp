{
  "name": "amd-web-app",
  "version": "0.1.0",
  "private": true,
  "description": "ERP de manufactura \u2014 AMD M\u00e9xico (Ciudad Ju\u00e1rez, Guadalajara, El Paso TX)",
  "scripts": {
    "dev": "pnpm --filter api dev & pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter api build && pnpm --filter web build",
    "db:generate": "pnpm --filter api prisma generate",
    "db:migrate": "pnpm --filter api prisma migrate dev",
    "db:seed": "pnpm --filter api prisma db seed",
    "db:studio": "pnpm --filter api prisma studio",
    "lint": "pnpm --filter api lint && pnpm --filter web lint",
    "test": "pnpm --filter @amd/api test"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@nestjs/core",
      "@nestjs/platform-express",
      "prisma",
      "@prisma/client",
      "bcryptjs",
      "class-validator",
      "class-transformer"
    ]
  }
}